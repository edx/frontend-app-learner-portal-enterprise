data: {"type":"data-block","id":"blk_2","data":{"v":1,"type":"item_section","props":{"item_type":"course","label":"Courses · 3 picks","dek":"Short, practical courses for new managers.","fallback":false,"items":[{"item_id":"edX+LDR201","item_type":"course","title":"Leading High-Performing Teams","image_url":"https://prod-discovery.edx-cdn.org/media/course/image/edx-ldr201.jpg","partner_name":"edX","partner_logo_url":null,"link":{"kind":"course","course_key":"edX+LDR201","course_type":"verified-audit"},"facts":{"level_type":"Intermediate","weeks_to_complete":6,"pacing_type":"self_paced"},"why":"You said you want to lead a team; this builds the coaching and delegation habits new managers lean on first.","fit":["Leadership","Self-paced"]},{"item_id":"edX+COM110","item_type":"course","title":"Communicating with Influence","image_url":"https://prod-discovery.edx-cdn.org/media/course/image/edx-com110.jpg","partner_name":"edX","partner_logo_url":null,"link":{"kind":"course","course_key":"edX+COM110","course_type":"verified-audit"},"facts":{"level_type":"Introductory","weeks_to_complete":4,"pacing_type":"self_paced"},"why":"Clear communication is the skill your team will notice first, and this one fits in four weeks.","fit":["Communication","Under 4 weeks"]},{"item_id":"edX+STR305","item_type":"course","title":"Strategic Thinking for Managers","image_url":"https://prod-discovery.edx-cdn.org/media/course/image/edx-str305.jpg","partner_name":"edX","partner_logo_url":null,"link":{"kind":"course","course_key":"edX+STR305","course_type":"verified-audit"},"facts":{"level_type":"Advanced","weeks_to_complete":8,"pacing_type":"instructor_paced"},"why":"Once the basics are in place, this helps you set direction rather than just run the day to day.","fit":["Strategy"]}]}}}

